                  <span className="text-gray-600">Current Energy</span>
                  <span className="font-bold" style={{ color: selectedColor }}>{energyLevel}%</span>
                </div>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value={energyLevel}
                  onChange={(e) => setEnergyLevel(parseInt(e.target.value))}
                  className="w-full h-2 rounded-full appearance-none cursor-pointer"
                  style={{
                    background: `linear-gradient(to right, ${selectedColor} 0%, ${selectedColor} ${energyLevel}%, #E5E7EB ${energyLevel}%, #E5E7EB 100%)`
                  }}
                />
              </div>
              
              <div className="flex gap-2 flex-wrap">
                {moodEmojis.map(mood => (
                  <button
                    key={mood.emoji}
                    onClick={() => toggleEmoji(mood.emoji)}
                    className={`text-3xl p-2 rounded-2xl transition-transform hover:scale-110 ${
                      selectedEmojis.includes(mood.emoji) ? 'bg-purple-100 scale-110' : 'bg-gray-50'
                    }`}
                  >
                    {mood.emoji}
                  </button>
                ))}
              </div>
            </div>
          </div>

          {/* Panic Rescue Button - Always Visible */}
          {showPanicButton && (
            <div className="bg-gradient-to-r from-red-500 to-pink-500 rounded-3xl shadow-lg p-6 mb-6 text-white">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-xl font-bold mb-1">Feeling Overwhelmed?</h3>
                  <p className="text-sm opacity-90">Quick rescue tools - 10-60 seconds</p>
                </div>
                <Heart className="animate-pulse" size={32} />
              </div>
              
              <div className="grid grid-cols-2 gap-3 mt-4">
                {panicTools.map(tool => (
                  <button
                    key={tool.id}
                    onClick={() => startPanicRescue(tool.id)}
                    className={`${tool.color} p-4 rounded-2xl text-white font-semibold flex flex-col items-center gap-2 hover:scale-105 transition-transform shadow-md`}
                  >
                    <tool.icon size={24} />
                    <span className="text-xs">{tool.name}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Main Actions Grid */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            {/* AI Friend Chat */}
            <button
              onClick={() => setCurrentScreen('chat')}
              className="bg-gradient-to-br from-purple-500 to-pink-500 rounded-3xl p-8 text-white text-left hover:scale-105 transition-transform shadow-lg"
            >
              <MessageCircle size={32} className="mb-3" />
              <h3 className="text-xl font-bold mb-2">Ongea Nami</h3>
              <p className="text-sm opacity-90">Your AI friend is here to listen</p>
            </button>

            {/* Journal */}
            <button
              onClick={() => setCurrentScreen('journal')}
              className="bg-gradient-to-br from-blue-500 to-teal-500 rounded-3xl p-8 text-white text-left hover:scale-105 transition-transform shadow-lg"
            >
              <Book size={32} className="mb-3" />
              <h3 className="text-xl font-bold mb-2">Sema Moyo</h3>
              <p className="text-sm opacity-90">Journal your thoughts safely</p>
            </button>

            {/* Calm Tools */}
            <button
              onClick={() => setCurrentScreen('calmTools')}
              className="bg-gradient-to-br from-green-500 to-emerald-500 rounded-3xl p-8 text-white text-left hover:scale-105 transition-transform shadow-lg"
            >
              <Sparkles size={32} className="mb-3" />
              <h3 className="text-xl font-bold mb-2">Calm Zone</h3>
              <p className="text-sm opacity-90">Breathing, meditation & more</p>
            </button>

            {/* Mood Dashboard */}
            <button
              onClick={() => setCurrentScreen('dashboard')}
              className="bg-gradient-to-br from-orange-500 to-red-500 rounded-3xl p-8 text-white text-left hover:scale-105 transition-transform shadow-lg"
            >
              <BarChart3 size={32} className="mb-3" />
              <h3 className="text-xl font-bold mb-2">Your Journey</h3>
              <p className="text-sm opacity-90">See your emotional patterns</p>
            </button>
          </div>

          {/* Daily Affirmation */}
          <div className="bg-gradient-to-r from-yellow-400 to-orange-400 rounded-3xl p-6 text-white text-center shadow-lg">
            <div className="text-2xl mb-3">💛</div>
            <p className="text-lg font-semibold mb-1">{affirmations[affirmationIndex].sw}</p>
            <p className="text-sm opacity-90">{affirmations[affirmationIndex].en}</p>
            <button
              onClick={() => setAffirmationIndex((affirmationIndex + 1) % affirmations.length)}
              className="mt-4 px-6 py-2 bg-white/20 backdrop-blur rounded-full text-sm hover:bg-white/30 transition"
            >
              Another One ✨
            </button>
          </div>
        </div>

        {/* Bottom Navigation */}
        <div className="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-lg">
          <div className="max-w-6xl mx-auto px-4 py-3 flex justify-around">
            <button onClick={() => setCurrentScreen('home')} className="flex flex-col items-center gap-1 text-purple-600">
              <Home size={24} />
              <span className="text-xs font-medium">Home</span>
            </button>
            <button onClick={() => setCurrentScreen('journal')} className="flex flex-col items-center gap-1 text-gray-400 hover:text-gray-600">
              <Book size={24} />
              <span className="text-xs">Journal</span>
            </button>
            <button onClick={() => setCurrentScreen('chat')} className="flex flex-col items-center gap-1 text-gray-400 hover:text-gray-600">
              <MessageCircle size={24} />
              <span className="text-xs">Chat</span>
            </button>
            <button onClick={() => setCurrentScreen('dashboard')} className="flex flex-col items-center gap-1 text-gray-400 hover:text-gray-600">
              <BarChart3 size={24} />
              <span className="text-xs">Insights</span>
            </button>
          </div>
        </div>
      </div>
    );
  }

  // AI Chat Screen
  if (currentScreen === 'chat') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-purple-50 to-pink-50 pb-24">
        <div className="bg-gradient-to-r from-purple-600 to-pink-600 text-white p-4 sticky top-0 z-10 shadow-lg">
          <div className="max-w-4xl mx-auto flex items-center justify-between">
            <button onClick={() => setCurrentScreen('home')} className="p-2 hover:bg-white/10 rounded-full">
              <ChevronLeft size={24} />
            </button>
            <div className="text-center">
              <h2 className="text-xl font-bold">Ongea Nami AI</h2>
              <p className="text-xs opacity-80">Your safe space. Zero judgment.</p>
            </div>
            <div className="w-10"></div>
          </div>
        </div>

        <div className="max-w-4xl mx-auto p-4 space-y-4">
          {chatMessages.map((msg, idx) => (
            <div key={idx} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
              <div className={`max-w-[80%] p-4 rounded-3xl ${
                msg.sender === 'user' 
                  ? 'bg-gradient-to-r from-purple-500 to-pink-500 text-white' 
                  : 'bg-white shadow-md text-gray-800'
              }`}>
                <p className="text-sm">{msg.text}</p>
                <p className="text-xs opacity-60 mt-1">
                  {msg.time.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div className="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4">
          <div className="max-w-4xl mx-auto flex gap-2">
            <input
              type="text"
              value={chatInput}
              onChange={(e) => setChatInput(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && sendChatMessage()}
              placeholder="Sema moyo wako... type anything"
              className="flex-1 px-6 py-3 bg-gray-100 rounded-full focus:outline-none focus:ring-2 focus:ring-purple-500"
            />
            <button
              onClick={sendChatMessage}
              className="p-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-full hover:scale-105 transition-transform shadow-lg"
            >
              <Send size={24} />
            </button>
          </div>
        </div>
      </div>
    );
  }

  // Journal Screen
  if (currentScreen === 'journal') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-blue-50 to-teal-50 pb-24">
        <div className="bg-gradient-to-r from-blue-600 to-teal-600 text-white p-4 sticky top-0 z-10 shadow-lg">
          <div className="max-w-4xl mx-auto flex items-center justify-between">
            <button onClick={() => setCurrentScreen('home')} className="p-2 hover:bg-white/10 rounded-full">
              <ChevronLeft size={24} />
            </button>
            <h2 className="text-xl font-bold">Sema Moyo</h2>
            <button onClick={saveJournalEntry} className="px-4 py-2 bg-white/20 rounded-full text-sm hover:bg-white/30">
              Save
            </button>
          </div>
        </div>

        <div className="max-w-4xl mx-auto p-4 space-y-6">
          {/* Emoji Selector */}
          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="font-semibold text-gray-800 mb-3">How are you feeling?</h3>
            <div className="flex gap-3 flex-wrap">
              {moodEmojis.map(mood => (
                <button
                  key={mood.emoji}
                  onClick={() => toggleEmoji(mood.emoji)}
                  className={`text-4xl p-3 rounded-2xl transition-all ${
                    selectedEmojis.includes(mood.emoji) 
                      ? 'bg-blue-100 scale-110 shadow-md' 
                      : 'bg-gray-50 hover:bg-gray-100'
                  }`}
                >
                  {mood.emoji}
                </button>
              ))}
            </div>
            {selectedEmojis.length > 0 && (
              <div className="mt-3 text-sm text-gray-600">
                Selected: {selectedEmojis.join(' ')}
              </div>
            )}
          </div>

          {/* Free Journal */}
          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="font-semibold text-gray-800 mb-3">Just say it. No judgment here.</h3>
            <textarea
              value={currentJournal}
              onChange={(e) => setCurrentJournal(e.target.value)}
              placeholder="Andika... write anything on your mind. It's safe here. 💚"
              className="w-full h-64 p-4 bg-gray-50 rounded-2xl focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
            />
            
            {/* Voice Note Option */}
            <div className="mt-4 flex gap-3">
              <button
                onClick={() => setVoiceRecording(!voiceRecording)}
                className={`flex items-center gap-2 px-6 py-3 rounded-full transition-all ${
                  voiceRecording 
                    ? 'bg-red-500 text-white animate-pulse' 
                    : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                }`}
              >
                <Mic size={20} />
                <span className="text-sm font-medium">
                  {voiceRecording ? 'Recording...' : 'Voice Note'}
                </span>
              </button>
              
              <button
                onClick={saveJournalEntry}
                className="flex-1 px-6 py-3 bg-gradient-to-r from-blue-600 to-teal-600 text-white rounded-full font-semibold hover:scale-105 transition-transform shadow-lg"
              >
                Save Entry ✨
              </button>
            </div>
          </div>

          {/* Past Entries */}
          {journalEntries.length > 0 && (
            <div className="space-y-3">
              <h3 className="font-semibold text-gray-800">Your Journey</h3>
              {journalEntries.map(entry => (
                <div key={entry.id} className="bg-white rounded-2xl p-4 shadow">
                  <div className="flex items-center justify-between mb-2">
                    <div className="flex gap-2">
                      {entry.emojis.map((emoji, idx) => (
                        <span key={idx} className="text-2xl">{emoji}</span>
                      ))}
                    </div>
                    <span className="text-xs text-gray-500">
                      {new Date(entry.date).toLocaleDateString()}
                    </span>
                  </div>
                  <p className="text-sm text-gray-700">{entry.text}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    );
  }

  // Calm Tools Screen
  if (currentScreen === 'calmTools') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-green-50 to-emerald-50 pb-24">
        <div className="bg-gradient-to-r from-green-600 to-emerald-600 text-white p-4 sticky top-0 z-10 shadow-lg">
          <div className="max-w-4xl mx-auto flex items-center justify-between">
            <button onClick={() => setCurrentScreen('home')} className="p-2 hover:bg-white/10 rounded-full">
              <ChevronLeft size={24} />
            </button>
            <h2 className="text-xl font-bold">Calm Zone</h2>
            <div className="w-10"></div>
          </div>
        </div>

        <div className="max-w-4xl mx-auto p-4 space-y-6">
          {/* Breathing Exercise */}
          <div className="bg-white rounded-3xl p-8 shadow-lg text-center">
            <h3 className="text-2xl font-bold text-gray-800 mb-2">Pumzi ya Utulivu</h3>
            <p className="text-sm text-gray-600 mb-6">4-7-8 Breathing</p>
            
            {!breathingActive ? (
              <button
                onClick={() => {
                  setBreathingActive(true);
                  setBreathCount(0);
                  setBreathPhase('inhale');
                }}
                className="px-8 py-4 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-full font-semibold hover:scale-105 transition-transform shadow-lg"
              >
                Start Breathing 🌬️
              </button>
            ) : (
              <div className="space-y-6">
                <div 
                  className={`w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-green-400 to-emerald-500 flex items-center justify-center transition-all duration-1000 ${
                    breathPhase === 'inhale' ? 'scale-125' : breathPhase === 'hold' ? 'scale-125' : 'scale-75'
                  }`}
                >
                  <span className="text-white text-2xl font-bold">
                    {breathPhase === 'inhale' ? 'Inhale' : breathPhase === 'hold' ? 'Hold' : 'Exhale'}
                  </span>
                </div>
                
                <p className="text-lg text-gray-700">
                  {breathPhase === 'inhale' && 'Pumua pole... breathe in slowly'}
                  {breathPhase === 'hold' && 'Shikilia... hold it gently'}
                  {breathPhase === 'exhale' && 'Toa hewa... exhale slowly'}
                </p>
                
                <div className="text-sm text-gray-500">Cycles completed: {breathCount}</div>
                
                <button
                  onClick={() => setBreathingActive(false)}
                  className="px-6 py-2 bg-gray-200 text-gray-700 rounded-full hover:bg-gray-300 transition"
                >
                  Stop
                </button>
              </div>
            )}
          </div>

          {/* Quick Calming Sounds */}
          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="text-xl font-bold text-gray-800 mb-4">Calming Sounds</h3>
            <div className="grid grid-cols-2 gap-3">
              {calmSounds.map(sound => (
                <button
                  key={sound.id}
                  onClick={() => setPlayingSound(playingSound === sound.id ? null : sound.id)}
                  className={`p-6 rounded-2xl text-left transition-all ${
                    playingSound === sound.id 
                      ? 'bg-gradient-to-br from-green-500 to-emerald-500 text-white scale-105 shadow-xl' 
                      : 'bg-gray-50 hover:bg-gray-100'
                  }`}
                >
                  <div className="text-4xl mb-2">{sound.icon}</div>
                  <h4 className="font-semibold text-sm">{sound.name}</h4>
                  <p className="text-xs opacity-70 mt-1">{sound.nameEn}</p>
                </button>
              ))}
            </div>
          </div>

          {/* Grounding Exercise */}
          <div className="bg-gradient-to-br from-purple-500 to-pink-500 rounded-3xl p-8 text-white shadow-lg">
            <h3 className="text-2xl font-bold mb-2">5-4-3-2-1 Grounding</h3>
            <p className="text-sm opacity-90 mb-6">When you feel disconnected or anxious</p>
            
            <div className="space-y-3 text-sm">
              <p>👁️ Name <strong>5 things</strong> you can see</p>
              <p>✋ Name <strong>4 things</strong> you can touch</p>
              <p>👂 Name <strong>3 things</strong> you can hear</p>
              <p>👃 Name <strong>2 things</strong> you can smell</p>
              <p>👅 Name <strong>1 thing</strong> you can taste</p>
            </div>
            
            <p className="text-xs opacity-80 mt-6 italic">This brings you back to the present moment. Uko hapa. Uko salama.</p>
          </div>
        </div>
      </div>
    );
  }

  // Dashboard Screen
  if (currentScreen === 'dashboard') {
    const avgEnergy = Math.round(moodHistory.reduce((sum, day) => sum + day.energy, 0) / moodHistory.length);
    const moodCounts = moodHistory.reduce((acc, day) => {
      acc[day.mood] = (acc[day.mood] || 0) + 1;
      return acc;
    }, {});
    const dominantMood = Object.entries(moodCounts).sort((a, b) => b[1] - a[1])[0];

    return (
      <div className="min-h-screen bg-gradient-to-br from-orange-50 to-red-50 pb-24">
        <div className="bg-gradient-to-r from-orange-600 to-red-600 text-white p-4 sticky top-0 z-10 shadow-lg">
          <div className="max-w-4xl mx-auto flex items-center justify-between">
            <button onClick={() => setCurrentScreen('home')} className="p-2 hover:bg-white/10 rounded-full">
              <ChevronLeft size={24} />
            </button>
            <h2 className="text-xl font-bold">Your Journey</h2>
            <div className="w-10"></div>
          </div>
        </div>

        <div className="max-w-4xl mx-auto p-4 space-y-6">
          {/* Stats Overview */}
          <div className="grid grid-cols-2 gap-4">
            <div className="bg-white rounded-3xl p-6 shadow-lg text-center">
              <TrendingUp className="mx-auto mb-2 text-orange-500" size={32} />
              <div className="text-3xl font-bold text-gray-800">{avgEnergy}%</div>
              <p className="text-sm text-gray-600 mt-1">Avg Energy</p>
            </div>
            
            <div className="bg-white rounded-3xl p-6 shadow-lg text-center">
              <Heart className="mx-auto mb-2 text-pink-500" size={32} />
              <div className="text-3xl font-bold text-gray-800">{moodHistory.length}</div>
              <p className="text-sm text-gray-600 mt-1">Days Tracked</p>
            </div>
          </div>

          {/* Dominant Mood */}
          <div className="bg-gradient-to-br from-purple-500 to-pink-500 rounded-3xl p-6 shadow-lg text-white">
            <h3 className="text-lg font-bold mb-2">Your Vibe This Week</h3>
            <div className="flex items-center gap-3">
              <span className="text-5xl">{moodEmojis.find(m => m.name === dominantMood[0])?.emoji}</span>
              <div>
                <p className="text-2xl font-bold capitalize">{dominantMood[0]}</p>
                <p className="text-sm opacity-80">{dominantMood[1]} days</p>
              </div>
            </div>
          </div>

          {/* Mood History */}
          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="text-lg font-bold text-gray-800 mb-4">Recent Check-ins</h3>
            <div className="space-y-3">
              {moodHistory.slice().reverse().map((day, idx) => (
                <div key={idx} className="flex items-center justify-between p-4 bg-gray-50 rounded-2xl">
                  <div className="flex items-center gap-3">
                    <span className="text-3xl">{moodEmojis.find(m => m.name === day.mood)?.emoji}</span>
                    <div>
                      <p className="font-semibold text-gray-800 capitalize">{day.mood}</p>
                      <p className="text-xs text-gray-500">{day.note}</p>
                    </div>
                  </div>
                  <div className="text-right">
                    <p className="text-lg font-bold text-gray-800">{day.energy}%</p>
                    <p className="text-xs text-gray-500">{new Date(day.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Insights */}
          <div className="bg-gradient-to-br from-blue-500 to-teal-500 rounded-3xl p-6 shadow-lg text-white">
            <h3 className="text-lg font-bold mb-3">💡 Insight</h3>
            <p className="text-sm opacity-90">
              {avgEnergy > 70 
                ? "Your energy has been strong! Keep doing what you're doing. 🌟"
                : avgEnergy > 50
                ? "You're doing okay. Remember to take breaks and practice self-care. 💚"
                : "It's been tough lately. Be gentle with yourself. Consider reaching out for support. 💙"}
            </p>
          </div>
        </div>
      </div>
    );
  }

  // Settings Screen
  if (currentScreen === 'settings') {
    return (
      <div className="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 pb-24">
        <div className="bg-gradient-to-r from-gray-800 to-gray-900 text-white p-4 sticky top-0 z-10 shadow-lg">
          <div className="max-w-4xl mx-auto flex items-center justify-between">
            <button onClick={() => setCurrentScreen('home')} className="p-2 hover:bg-white/10 rounded-full">
              <ChevronLeft size={24} />
            </button>
            <h2 className="text-xl font-bold">Settings</h2>
            <div className="w-10"></div>
          </div>
        </div>

        <div className="max-w-4xl mx-auto p-4 space-y-4">
          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="font-bold text-gray-800 mb-4">Crisis Resources</h3>
            <div className="space-y-3">
              <a href="tel:1199" className="flex items-center gap-3 p-4 bg-red-50 rounded-2xl hover:bg-red-100 transition">
                <Phone className="text-red-600" size={24} />
                <div>
                  <p className="font-semibold text-gray-800">Kenya Suicide Hotline</p>
                  <p className="text-sm text-gray-600">1199 (toll-free)</p>
                </div>
              </a>
              
              <a href="tel:0800720720" className="flex items-center gap-3 p-4 bg-blue-50 rounded-2xl hover:bg-blue-100 transition">
                <Phone className="text-blue-600" size={24} />
                <div>
                  <p className="font-semibold text-gray-800">Kenya Red Cross</p>
                  <p className="text-sm text-gray-600">0800 720 720</p>
                </div>
              </a>
            </div>
          </div>

          <div className="bg-white rounded-3xl p-6 shadow-lg">
            <h3 className="font-bold text-gray-800 mb-4">About VibeCheck</h3>
            <p className="text-sm text-gray-600 mb-3">
              VibeCheck is your safe, judgment-free space for mental wellness. We're here to support you, not diagnose you.
            </p>
            <p className="text-xs text-gray-500 italic">
              If you're experiencing a mental health crisis, please reach out to a professional or call the hotlines above.
            </p>
          </div>

          <button
            onClick={() => {
              setCurrentScreen('welcome');
              setCalmZone({ visual: null, sound: null, color: null, breathing: null });
            }}
            className="w-full p-4 bg-purple-100 text-purple-700 rounded-2xl font-semibold hover:bg-purple-200 transition"
          >
            Retake Calm Zone Discovery
          </button>
        </div>
      </div>
    );
  }

  return null;
};

export default VibeCheckApp;
